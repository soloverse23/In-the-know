{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "cookie", "key": "itk-lang", "value": "ro" }],
      "destination": "/ro",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "RO" }],
      "missing": [{ "type": "cookie", "key": "itk-lang" }],
      "destination": "/ro",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/ro", "destination": "/" },
    { "source": "/ro/", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
